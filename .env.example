# Copy to .env.local (Next.js) or set in Vercel → Project → Settings → Environment Variables.
# Nothing below is connected yet; every external channel stays "not configured" until its key is set
# AND the channel is enabled in Settings → Automation (channel_config.enabled = true).

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable / anon key>
# Server only. Never expose to the browser. Used by the scheduler route and the delivery worker.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Protects /api/cron/* routes when Vercel Cron is used instead of pg_cron
CRON_SECRET=<long random string>

# Email delivery (e.g. Resend or Amazon SES) — used by the delivery worker for notifications.delivery = 'queued'
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM="M Andamul <noreply@your-domain>"

# WhatsApp Business Cloud API (Meta) — approved templates only
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAMESPACE=

# AI assistant (server-side route only; the assistant reads through the user's own session and never writes)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
